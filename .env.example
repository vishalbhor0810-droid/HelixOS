# HelixOS Backend Configuration
HOST=127.0.0.1
PORT=8000

# LLM Provider Configuration
# Supported providers: groq, gemini, openai
LLM_PROVIDER=groq
LLM_API_KEY=your_api_key_here
LLM_MODEL=llama-3.1-8b-instant
LLM_BASE_URL=

# Embedding & Vector Database Settings
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHROMA_PERSIST_DIR=./chroma_db

# Minimum cosine similarity (0-1) for a chunk to be used as context
SIMILARITY_THRESHOLD=0.10

# Max chunks from one file in the results (merged into one source per file)
MAX_CHUNKS_PER_FILE=2

# Vision fallback: scanned PDF pages that local OCR reads with low confidence
# (typically handwriting) are transcribed by the provider's vision model.
# Page images are sent to the LLM provider; set to false to keep everything local.
VISION_FALLBACK=true
# Leave empty for the provider default (groq: qwen/qwen3.8-27b, gemini: gemini-2.5-flash, openai: gpt-4o-mini)
VISION_MODEL=
# Average EasyOCR confidence (0-1) below which a page goes to the vision model
VISION_MIN_CONFIDENCE=0.6
# Max pages per document sent to the vision model
VISION_MAX_PAGES=20
